// CantinaFast — schema PROVISÓRIO (versão reduzida do Murilo, ver CLAUDE.md)
//
// Reconstruído a partir da descrição do CLAUDE.md, não do arquivo original do Murilo.
// Os valores dos enums TipoMovimentacaoEstoque, CanalPedido e StatusPedido e os tipos
// exatos das colunas são suposições — substituir por este arquivo quando o Murilo enviar o real.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum PerfilUsuario {
  ATENDENTE
  CAIXA
  ADMINISTRADOR
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  PERDA
  RETORNO
}

enum CanalPedido {
  PRESENCIAL
  ONLINE
}

enum StatusPedido {
  PENDENTE
  CONFIRMADO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  PIX
  DEBITO
  CREDITO
  DINHEIRO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  EXPIRADO
  ESTORNADO
}

// ---------- Entidades ----------

model Usuario {
  id        Int           @id @default(autoincrement())
  nome      String        @db.VarChar(120)
  login     String        @unique @db.VarChar(120)
  senhaHash String        @db.VarChar(255)
  perfil    PerfilUsuario
  ativo     Boolean       @default(true)
  criadoEm  DateTime      @default(now())

  pedidos       Pedido[]
  movimentacoes MovimentacaoEstoque[]

  @@map("usuarios")
}

model Categoria {
  id    Int     @id @default(autoincrement())
  nome  String  @db.VarChar(80)
  ativa Boolean @default(true)

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id                   Int      @id @default(autoincrement())
  categoriaId          Int
  nome                 String   @db.VarChar(140)
  descricao            String?
  precoVenda           Decimal  @db.Decimal(12, 2)
  codigoBarras         String?  @unique @db.VarChar(80)
  imagemUrl            String?  @db.VarChar(500)
  disponivelPresencial Boolean  @default(true)
  disponivelOnline     Boolean  @default(true)
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now())

  categoria     Categoria             @relation(fields: [categoriaId], references: [id])
  estoque       Estoque?
  movimentacoes MovimentacaoEstoque[]
  itensPedido   ItemPedido[]

  @@map("produtos")
}

model Estoque {
  id                  Int @id @default(autoincrement())
  produtoId           Int @unique
  quantidadeFisica    Int @default(0)
  quantidadeReservada Int @default(0)
  estoqueMinimo       Int @default(0)

  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("estoque")
}

model MovimentacaoEstoque {
  id         Int                     @id @default(autoincrement())
  produtoId  Int
  usuarioId  Int?
  tipo       TipoMovimentacaoEstoque
  quantidade Int
  motivo     String?                 @db.VarChar(255)
  criadoEm   DateTime                @default(now())

  produto Produto  @relation(fields: [produtoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("movimentacoes_estoque")
}

model Pedido {
  id         Int          @id @default(autoincrement())
  usuarioId  Int?
  // Cliente ainda não está modelado (fora do escopo desta entrega): campo solto, sem @relation.
  clienteId  Int?
  canal      CanalPedido
  status     StatusPedido @default(PENDENTE)
  valorTotal Decimal      @db.Decimal(12, 2)
  criadoEm   DateTime     @default(now())

  usuario    Usuario?     @relation(fields: [usuarioId], references: [id])
  itens      ItemPedido[]
  pagamentos Pagamento[]

  @@map("pedidos")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  produtoId     Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}

model Pagamento {
  id                   Int             @id @default(autoincrement())
  pedidoId             Int
  formaPagamento       FormaPagamento
  statusPagamento      StatusPagamento @default(PENDENTE)
  valor                Decimal         @db.Decimal(12, 2)
  identificadorExterno String?         @db.VarChar(150)
  criadoEm             DateTime        @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("pagamentos")
}
